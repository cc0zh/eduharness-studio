{
  "name": "eduharness-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@google/genai",
      "fsevents",
      "protobufjs"
    ]
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "dev": "node scripts/dev.mjs",
    "export:judge": "tsx apps/server/src/judge-export.ts",
    "m3:rehearse": "node --import tsx test/m3-rehearsal.mjs",
    "build": "pnpm --filter @eduharness-studio/web run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:hygiene": "node scripts/check-code-hygiene.mjs",
    "check:static": "node scripts/check-static.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "node --test test/browser-m1.test.mjs test/browser-m2-1.test.mjs test/browser-m2-2.test.mjs test/browser-m2-2b.test.mjs test/browser-m2-3.test.mjs test/browser-m2-4-graph.test.mjs test/browser-m2-5-lifecycle.test.mjs test/browser-ux-audit.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@eduharness-studio/engine": "workspace:*",
    "@hono/node-server": "^1.14.1",
    "@sinclair/typebox": "0.34.52",
    "@types/node": "^22.15.0",
    "playwright": "^1.65.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
